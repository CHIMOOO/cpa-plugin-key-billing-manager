FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/cpa-state-collector ./cmd/cpa-state-collector
COPY internal/statecollector ./internal/statecollector
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/cpa-state-collector ./cmd/cpa-state-collector

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/cpa-state-collector /usr/local/bin/cpa-state-collector
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/cpa-state-collector"]
